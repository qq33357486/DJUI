{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://djui.duojie.games/schemas/v6/sounds.schema.json",
  "title": "DJUI v6 Sounds",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "schemaVersion", "defaultButtonSoundId", "sounds"],
  "properties": {
    "protocolVersion": { "const": 6 },
    "schemaVersion": { "const": 1 },
    "defaultButtonSoundId": { "type": ["string", "null"] },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "uri"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "gameDataPath": { "type": "string" },
          "category": { "type": "string" },
          "controlTypes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
